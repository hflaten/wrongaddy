# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Get these from: https://developers.facebook.com/apps → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token   # Choose any string — must match what you enter in Meta dashboard
WHATSAPP_PHONE_NUMBER_ID=

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=   # Use the service_role key (NOT the anon key)

# ─── Resend (email) ───────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_DOMAIN=notifications@yourdomain.com.au  # Must be a verified domain in Resend

# ─── Tavily (web search for email finder agent) ───────────────────────────────
# https://tavily.com — free tier: 1000 searches/month
TAVILY_API_KEY=

# ─── Lob.com (physical letters) ──────────────────────────────────────────────
# https://dashboard.lob.com/settings/api-keys
# Use test key (test_...) during development — no real letters sent
LOB_API_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
